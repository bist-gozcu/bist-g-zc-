# ============================================================
# BIST Gözcü — Ortam Değişkenleri Şablonu
# ============================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# cp .env.example .env
# ============================================================

# ---------- API Proxy ----------
# Yahoo Finance proxy sunucu adresi (Replit dağıtımı veya kendi sunucunuz)
# Varsayılan: Replit proxy kullanılır
EXPO_PUBLIC_DOMAIN=bist-gozcu--careki73.replit.app

# ---------- Alternatif Ücretsiz Veri Kaynağı (İsteğe Bağlı) ----------
# Twelve Data ücretsiz API anahtarı. Yahoo verisinde bir önceki seans kapanışı
# boş geldiğinde yüzde değişim yanlış çıkabiliyor (ör. ±%10 marjı aşan değerler).
# Bu anahtar tanımlıysa, uygulama şüpheli satırları Twelve Data (Borsa İstanbul)
# verisiyle otomatik onarır. Ömür boyu ücretsiz: https://twelvedata.com/pricing
# (800 istek/gün, 8 istek/dk). Boş bırakılırsa yalnızca Yahoo kullanılır.
# EXPO_PUBLIC_TWELVEDATA_KEY=

# ---------- EAS Build ----------
# Expo Application Services proje ID'si
EXPO_PUBLIC_EAS_PROJECT_ID=435c8db3-09ed-4f21-a023-f351ad4b6162

# ---------- Crash & Analytics (İsteğe Bağlı) ----------
# Sentry DSN (hata takibi için)
# EXPO_PUBLIC_SENTRY_DSN=

# ---------- Bildirimler (İsteğe Bağlı) ----------
# Expo push bildirim proje ID
# EXPO_PUBLIC_EXPERIENCE_ID=
